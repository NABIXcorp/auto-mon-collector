# {{.Prefix}}/systemd/monitoring-collector.service  (generated by amc, linked into /etc/systemd/system)
# Collector unit for {{.Prefix}}. Do not edit: amc rewrites it (backup in {{.Prefix}}/backup/).
# Secrets: {{.Prefix}}/secrets/collector.env (root 600, never printed). Switches: config/host.env.
[Unit]
Description=monitoring-collector (OpenTelemetry Collector, {{.Prefix}})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.User}}
Group={{.User}}
# Journal read access (v0.19.0): kernel warnings + sshd logins (config/journal.yaml: fixed filters, only the message
# leaves the receiver, unknown SSH user names masked before the disk queue). The process can read the whole journal.
SupplementaryGroups=systemd-journal
EnvironmentFile={{.Prefix}}/secrets/collector.env
EnvironmentFile={{.Prefix}}/config/host.env
Environment=MONITORING_DATA={{.Prefix}}/data
ExecStart={{.Prefix}}/bin/monitoring-collector --config={{.Prefix}}/config/config.yaml --config={{.Prefix}}/config/journal.yaml --config={{.Prefix}}/config/host.yaml{{range .SiteConfigs}} --config={{.}}{{end}}
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
# Sandbox: the whole system is read-only for the collector except its own data directory.
# (It only READS logs, the journal, /proc and its config; it writes the disk queue, bookmarks and nothing else.)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{.Prefix}}/data

[Install]
WantedBy=multi-user.target
