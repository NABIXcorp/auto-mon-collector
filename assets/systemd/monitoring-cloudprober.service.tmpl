# {{.Prefix}}/systemd/monitoring-cloudprober.service  (generated by amc, linked into /etc/systemd/system)
# Cloudprober (v0.12.0): the probes of the answers file (TCP / HTTP / ping to other hosts and APIs). Only installed
# when the answers have probes. Metrics on 127.0.0.1:9313, scraped by the local collector. Do not edit.
[Unit]
Description=Cloudprober probes for the monitoring collector ({{.Prefix}})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.User}}
Group={{.User}}
ExecStart={{.Prefix}}/bin/cloudprober --config_file={{.Prefix}}/config/cloudprober.cfg --logfmt=text
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
{{- if .Ping}}
# ping probes: raw ICMP socket, this one capability only (no change to net.ipv4.ping_group_range)
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
{{- else}}
CapabilityBoundingSet=
{{- end}}
MemoryMax=150M

[Install]
WantedBy=multi-user.target
