# {{.Prefix}}/systemd/monitoring-kmsg.service  (generated by amc, linked into /etc/systemd/system)
# Kernel warnings / errors (netconn/otel-kmsg.sh) -> data/kmsg -> collector file_log/kmsg (stream kernel).
# Only THIS unit gets the group systemd-journal (journal read access); the collector unit does not.
[Unit]
Description=Kernel warnings and errors for the monitoring collector
After=systemd-journald.service

[Service]
Type=simple
User={{.User}}
Group={{.User}}
SupplementaryGroups=systemd-journal
Environment=KMSG_DIR={{.Prefix}}/data/kmsg
UMask=0027
ExecStart={{.Prefix}}/netconn/otel-kmsg.sh --poll
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths={{.Prefix}}/data/kmsg
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=32M

[Install]
WantedBy=multi-user.target
