# {{.Prefix}}/systemd/monitoring-update.service  (generated by monitoring-agent, linked into /etc/systemd/system, never enabled)
# monitoring-agent self-update (v0.16.0): started by the agent after a signed update request (polkit: the agent may START this
# unit, nothing else). Root, oneshot: re-verifies the request itself (signature with the key pinned in answers.yaml,
# host, expiry, agent.update in answers.yaml), downloads ONLY a signed release of the repository compiled into monitoring-agent,
# then runs `monitoring-agent update` (backup, plan, smoke run, rollback). Only with `agent:` in the answers. Do not edit.
[Unit]
Description=monitoring-agent self-update: a signed release requested through the agent ({{.Prefix}})
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart={{.Prefix}}/bin/monitoring-agent self-update --prefix {{.Prefix}} --request {{.Prefix}}/agent/update-request.json
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0022
