# {{.Prefix}}/systemd/monitoring-update.service  (generated by amc, linked into /etc/systemd/system, never enabled)
# amc self-update (v0.16.0): started by the agent after a signed update request (polkit: amc-agent may START this
# unit, nothing else). Root, oneshot: re-verifies the request itself (signature with the key pinned in answers.yaml,
# host, expiry, agent.update in answers.yaml), downloads ONLY a signed release of the repository compiled into amc,
# then runs `amc update` (backup, plan, smoke run, rollback). Only with `agent:` in the answers. Do not edit.
[Unit]
Description=amc self-update: a signed amc release requested through the agent ({{.Prefix}})
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart={{.Prefix}}/bin/amc self-update --prefix {{.Prefix}} --request {{.Prefix}}/agent/update-request.json
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0022
