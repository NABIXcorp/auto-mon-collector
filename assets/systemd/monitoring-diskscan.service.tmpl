# {{.Prefix}}/systemd/monitoring-diskscan.service  (generated by monitoring-agent, linked into /etc/systemd/system, never enabled)
# monitoring-agent disk-scan (v0.29.0): lists the biggest folders and files of each local disk for the console, like
# `du -x`. Started by the agent (polkit: the agent may START this unit, nothing else): daily, when a disk is >= 85 %
# full, or on a signed console request. Read-only: it lists folders and stats entries (CAP_DAC_READ_SEARCH, no other
# capability), never opens a file, has no network and writes only {{.Prefix}}/agent/diskscan/. Idle IO, Nice 19.
# Only with agent.disk_scan.allow in the answers. Do not edit.
[Unit]
Description=monitoring-agent disk scan: biggest folders and files per disk ({{.Prefix}})

[Service]
Type=oneshot
User={{.AgentUser}}
Group={{.AgentUser}}
ExecStart={{.Prefix}}/bin/monitoring-agent disk-scan --prefix {{.Prefix}}
TimeoutStartSec=11min
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{.Prefix}}/agent
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=200M
