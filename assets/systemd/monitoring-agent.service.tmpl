# {{.Prefix}}/systemd/monitoring-agent.service  (generated by amc, linked into /etc/systemd/system)
# amc agent (v0.13.0): fetches the signed probe list of this host from the control plane (outbound HTTPS only) and
# applies it to Cloudprober. Not root: it may write only {{.Prefix}}/agent and {{.Prefix}}/config/cloudprober, and
# restart only monitoring-cloudprober (polkit rule 50-amc-agent.rules). Only with `agent:` in the answers. Do not edit.
[Unit]
Description=amc agent: probe lists from the control plane ({{.Prefix}})
After=network-online.target monitoring-cloudprober.service
Wants=network-online.target

[Service]
Type=simple
User=amc-agent
Group=amc-agent
ExecStart={{.Prefix}}/bin/amc agent run --prefix {{.Prefix}}
Restart=always
RestartSec=30
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{.Prefix}}/agent {{.Prefix}}/config/cloudprober
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
# the agent runs `cloudprober --configtest` (~60 MB) as a child
MemoryMax=200M

[Install]
WantedBy=multi-user.target
