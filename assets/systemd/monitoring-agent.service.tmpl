# {{.Prefix}}/systemd/monitoring-agent.service  (generated by monitoring-agent, linked into /etc/systemd/system)
# monitoring-agent (v0.13.0, before v0.20.0 called amc): fetches the signed probe list of this host from the control plane (outbound HTTPS only) and
# applies it to monitoring-prober. Not root: it may write only {{.Prefix}}/agent and {{.Prefix}}/config/prober, and
# restart only monitoring-prober (polkit rule 50-monitoring-agent.rules). Only with `agent:` in the answers. Do not edit.
[Unit]
Description=monitoring-agent: probe lists and updates from the control plane ({{.Prefix}})
After=network-online.target monitoring-prober.service
Wants=network-online.target

[Service]
Type=simple
User={{.AgentUser}}
Group={{.AgentUser}}
ExecStart={{.Prefix}}/bin/monitoring-agent agent run --prefix {{.Prefix}}
Restart=always
RestartSec=30
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{.Prefix}}/agent {{.Prefix}}/config/prober
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
# the agent runs `monitoring-prober --configtest` (~60 MB) as a child
MemoryMax=200M

[Install]
WantedBy=multi-user.target
