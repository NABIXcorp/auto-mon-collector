# {{.Prefix}}/systemd/monitoring-sshd.service  (generated by amc, linked into /etc/systemd/system)
# SSH logins (netconn/otel-sshd.sh) -> data/sshd -> collector file_log/sshd (stream ssh).
# Journal access (group systemd-journal) only in this unit and monitoring-kmsg; reads sshd's messages only.
[Unit]
Description=SSH logins for the monitoring collector
After=systemd-journald.service

[Service]
Type=simple
User={{.User}}
Group={{.User}}
SupplementaryGroups=systemd-journal
Environment=SSHD_DIR={{.Prefix}}/data/sshd
UMask=0027
ExecStart={{.Prefix}}/netconn/otel-sshd.sh --poll
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths={{.Prefix}}/data/sshd
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=32M

[Install]
WantedBy=multi-user.target
