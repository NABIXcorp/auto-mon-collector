# {{.Prefix}}/systemd/monitoring-procs.service  (generated by amc, linked into /etc/systemd/system)
# Top processes by CPU and RSS (netconn/otel-procs.sh, every 60 s) -> data/procs -> collector file_log/procs.
# No root: plain ps; only command names, never arguments.
[Unit]
Description=Top processes (CPU, memory) for the monitoring collector

[Service]
Type=simple
User={{.User}}
Group={{.User}}
Environment=PROCS_DIR={{.Prefix}}/data/procs
UMask=0027
ExecStart={{.Prefix}}/netconn/otel-procs.sh --loop 60
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths={{.Prefix}}/data/procs
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=32M
Nice=10

[Install]
WantedBy=multi-user.target
