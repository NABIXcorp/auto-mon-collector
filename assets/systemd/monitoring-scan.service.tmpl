# {{.Prefix}}/systemd/monitoring-scan.service  (generated by monitoring-agent, linked into /etc/systemd/system, never enabled)
# monitoring-agent scan (v0.32.0): runs the installer's service scan again (the same detection as plan / apply /
# update) and rewrites {{.Prefix}}/inventory.json when the services changed (else it only sets its mtime = the scan
# time, the inventory's services_at), so a service installed later shows in
# the console without a manual update. Started by the agent (polkit: the agent may START this unit, nothing else):
# every 15 min and on a signed console request. It changes no configuration, no unit, no answers and restarts nothing.
# Root uid (inventory.json is root 644 in the root-owned prefix) but ONLY two capabilities:
#   CAP_DAC_READ_SEARCH  list other users' /proc/<pid>/fd, Oracle / Tomcat folders, the agent state
#   CAP_SYS_PTRACE       read other users' /proc/<pid>/fd links (socket -> process) and /proc/<pid>/environ
#                        (ORACLE_HOME, CATALINA_BASE ...); ptrace itself is blocked by the system call filter
# No network (IPAddressDeny=any, AF_UNIX only; /proc/net/tcp must stay the host's, so no PrivateNetwork), the
# prefix writable except bin, config, systemd, agent, data, backup; secrets inaccessible. Idle IO, Nice 19.
# Only with agent.rescan.allow in the answers. Do not edit.
[Unit]
Description=monitoring-agent service scan: rewrite inventory.json when the services changed ({{.Prefix}})

[Service]
Type=oneshot
User=root
Group=root
ExecStart={{.Prefix}}/bin/monitoring-agent scan --prefix {{.Prefix}}
TimeoutStartSec=4min
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{.Prefix}}
ReadOnlyPaths=-{{.Prefix}}/bin -{{.Prefix}}/config -{{.Prefix}}/systemd -{{.Prefix}}/agent -{{.Prefix}}/data -{{.Prefix}}/backup
InaccessiblePaths=-{{.Prefix}}/secrets
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=~@debug process_vm_readv process_vm_writev @mount @module @reboot @swap @raw-io @clock @cpu-emulation @obsolete
UMask=0022
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=200M
