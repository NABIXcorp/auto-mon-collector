# {{.Prefix}}/systemd/monitoring-netconn.service  (generated by amc, linked into /etc/systemd/system)
# TCP connection counts per port (netconn/otel-netconn.sh) -> data/netconn -> collector file_log/netconn.
# One long-running loop (not a 30 s timer) = no "Started/Finished" lines in the journal every 30 s.
[Unit]
Description=TCP connection counts per port for the monitoring collector
After=network-online.target

[Service]
Type=simple
User={{.User}}
Group={{.User}}
Environment=NETCONN_PORTS="1521 8080 443"
Environment=NETCONN_DIR={{.Prefix}}/data/netconn
# Per host: NETCONN_PORTS in host.env overrides the default above (EnvironmentFile wins over Environment).
EnvironmentFile=-{{.Prefix}}/config/host.env
ExecStart={{.Prefix}}/netconn/otel-netconn.sh --loop 30
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{.Prefix}}/data/netconn
RestrictAddressFamilies=AF_NETLINK AF_UNIX
CapabilityBoundingSet=
MemoryMax=32M

[Install]
WantedBy=multi-user.target
