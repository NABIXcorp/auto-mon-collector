# {{.Prefix}}/systemd/monitoring-otelcol.service  (generated by amc, linked into /etc/systemd/system)
# Collector unit for {{.Prefix}}. Do not edit: amc rewrites it (backup in {{.Prefix}}/backup/).
# Secrets: {{.Prefix}}/secrets/collector.env (root 600, never printed). Switches: config/host.env.
[Unit]
Description=OpenTelemetry Collector (monitoring, {{.Prefix}})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.User}}
Group={{.User}}
EnvironmentFile={{.Prefix}}/secrets/collector.env
EnvironmentFile={{.Prefix}}/config/host.env
Environment=MONITORING_DATA={{.Prefix}}/data
ExecStart={{.Prefix}}/bin/otelcol-contrib --config={{.Prefix}}/config/config.yaml --config={{.Prefix}}/config/host.yaml{{range .SiteConfigs}} --config={{.}}{{end}}
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
# Sandbox: the whole system is read-only for the collector except its own data directory.
# (It only READS logs, /proc and its config; it writes the disk queue, bookmarks and nothing else.)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{.Prefix}}/data

[Install]
WantedBy=multi-user.target
