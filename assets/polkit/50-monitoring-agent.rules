// /etc/polkit-1/rules.d/50-monitoring-agent.rules  (installed and removed by monitoring-agent; do not edit)
// The agent (user monitoring-agent) may RESTART the monitoring-prober unit and (v0.16.0) START the self-update unit.
// Nothing else: no other unit, no other verb. The self-update unit re-verifies every request as root.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "monitoring-agent" &&
        action.lookup("unit") == "monitoring-prober.service" &&
        action.lookup("verb") == "restart") {
        return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "monitoring-agent" &&
        action.lookup("unit") == "monitoring-update.service" &&
        action.lookup("verb") == "start") {
        return polkit.Result.YES;
    }
});
